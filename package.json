{
  "name": "random-verse-generator",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/strip-asyncify.mjs && node scripts/build-sw.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test",
    "data:build": "node scripts/build-data.mjs",
    "data:validate": "node scripts/validate.mjs",
    "data:semantic": "node scripts/build-passage-catalog.mjs && node scripts/build-embeddings.mjs && node scripts/validate-semantic-index.mjs",
    "data:related": "node scripts/build-related.mjs",
    "data:semantic:validate": "node scripts/validate-semantic-index.mjs",
    "eval:semantic": "node scripts/eval-semantic.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "wrangler": "^4.151.1"
  }
}
