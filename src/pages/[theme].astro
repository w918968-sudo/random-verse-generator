---
import Layout from '../layouts/Layout.astro';
import VerseGenerator from '../components/VerseGenerator.astro';
import { THEMES, ui } from '../i18n/en.mjs';
import { SITE_URL } from '../config.mjs';

export function getStaticPaths() {
  return THEMES.map((t) => ({
    params: { theme: t.id.toLowerCase() },
    props: { theme: t },
  }));
}

const { theme } = Astro.props;
const slug = theme.id.toLowerCase();
const pageTitle = `${theme.id} Bible Verses – ${ui.siteName}`;
const description = `Free ${slug} Bible verses from the World English Bible (Protestant Edition). ${theme.desc}`;
const canonical = new URL(`/${slug}/`, SITE_URL).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  url: canonical,
  description,
};
---

<Layout title={pageTitle} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <h1 class="hero-title">{theme.id} Bible Verses</h1>
  <p class="lede">{theme.desc}</p>

  <VerseGenerator initialTheme={theme.id} />

  <section class="seo-content">
    <h2>About {slug} Bible verses</h2>
    <p>
      This page brings together {slug} verses from the World English Bible (Protestant Edition), a
      public-domain modern English translation. Press “Generate Verse” to draw a random verse on this
      topic, or pick a different topic from the list below.
    </p>
    <h2>More topics</h2>
    <ul>
      {THEMES.map((t) => (
        <li>
          <a href={`/${t.id.toLowerCase()}/`}>{t.id} Bible Verses</a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
