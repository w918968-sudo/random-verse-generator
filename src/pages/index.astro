---
import Layout from '../layouts/Layout.astro';
import VerseGenerator from '../components/VerseGenerator.astro';
import { THEMES, OCCASIONS, ui, faq } from '../i18n/en.mjs';
import { TRANSLATIONS, SITE_URL } from '../config.mjs';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: ui.siteName,
  url: SITE_URL,
  description: ui.metaDescription,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  brand: { '@type': 'Brand', name: ui.brand },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: ui.siteName,
  url: SITE_URL,
  logo: `${SITE_URL}/icons/icon-512.png`,
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: ui.siteName,
  url: SITE_URL,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE_URL}/search/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout title={`${ui.siteName} – Free Bible Verses by Topic`}>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />

  <h1 class="hero-title">{ui.h1}</h1>
  <p class="lede">{ui.intro}</p>

  <VerseGenerator />

  <section class="seo-content">
    <h2>How this Bible verse generator works</h2>
    <p>
      Press <strong>Generate Verse</strong> to receive a random verse, or pick one of the topics
      below first to receive a verse on that theme. Every draw is picked from a curated library of
      well-known Bible verses, and the generator avoids repeating a verse until you have worked
      through the whole list.
    </p>

    <h2>Choose a topic</h2>
    <ul>
      {THEMES.map((t) => (
        <li>
          <strong>{t.id}</strong> — {t.desc}
        </li>
      ))}
    </ul>

    <h2>Bible verses for occasions</h2>
    <ul>
      {OCCASIONS.map((o) => (
        <li>
          <a href={`/${o.slug}/`}>{o.id} Bible Verses</a> — {o.desc}
        </li>
      ))}
    </ul>

    <h2>About the translations</h2>
    <p>
      Every verse is available in {TRANSLATIONS.length} public-domain translations: the World
      English Bible (Protestant Edition) and the King James Version. Both are in the public domain,
      so you are free to quote and share every verse without worrying about copyright. Pick your
      preferred translation with the switch above the verse.
    </p>
    <ul>
      {TRANSLATIONS.map((t) => (
        <li>
          <strong>{t.name}</strong> ({t.id}) — {t.licenseNote} Source:{' '}
          <a href={t.sourceUrl}>{t.sourceUrl}</a>.
        </li>
      ))}
    </ul>

    <h2>Frequently asked questions</h2>
    {faq.map((f) => (
      <>
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </>
    ))}
  </section>
</Layout>
