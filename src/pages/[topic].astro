---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import VerseGenerator from '../components/VerseGenerator.astro';
import { THEMES, OCCASIONS, ui } from '../i18n/en.mjs';
import { TOPIC_FAQ } from '../data/topic-faq.mjs';
import { SITE_URL } from '../config.mjs';

export function getStaticPaths() {
  return [
    ...THEMES.map((t) => ({
      params: { topic: t.id.toLowerCase() },
      props: { kind: 'theme', item: { id: t.id, slug: t.id.toLowerCase(), desc: t.desc } },
    })),
    ...OCCASIONS.map((o) => ({
      params: { topic: o.slug },
      props: { kind: 'occasion', item: o },
    })),
  ];
}

const { kind, item } = Astro.props;
const isOccasion = kind === 'occasion';
const pageTitle = `${item.id} Bible Verses – ${ui.siteName}`;
const topicLabel = isOccasion ? item.id : item.slug;
const description = `Free ${topicLabel} Bible verses from the World English Bible (Protestant Edition). ${item.desc}`;
const canonical = new URL(`/${item.slug}/`, SITE_URL).href;

// Static, indexable verse content. The generator draws verses client-side, so the
// verse text never appears in the page HTML — which leaves long-tail pages with
// almost no crawlable content. Pre-render a deterministic "top 10" list from the
// same /data/verses.json the client uses, so the two can never drift apart.
const VERSES_COUNT = 30;

function reference(v) {
  const range = v.startVerse === v.endVerse ? String(v.startVerse) : `${v.startVerse}–${v.endVerse}`;
  return `${v.bookName} ${v.chapter}:${range}`;
}

const versesPath = join(process.cwd(), 'public', 'data', 'verses.json');
const topicVerses = JSON.parse(readFileSync(versesPath, 'utf8'))
  .filter((v) => (isOccasion ? (v.occasions || []).includes(item.slug) : v.themes.includes(item.id)))
  .slice(0, VERSES_COUNT);
const versesHeading = `Top ${VERSES_COUNT} ${item.id} Bible verses`;
const topicFaq = TOPIC_FAQ[item.slug] || [];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: pageTitle,
    url: canonical,
    description,
  },
  ...(topicFaq.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: topicFaq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }]
    : []),
];

const themeProp = isOccasion ? '' : item.id;
const occasionProp = isOccasion ? item.slug : '';
---

<Layout title={pageTitle} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <h1 class="hero-title">{item.id} Bible Verses</h1>
  <p class="lede">{item.desc}</p>

  <VerseGenerator initialTheme={themeProp} initialOccasion={occasionProp} />

  <section class="topic-verses">
    <h2>{versesHeading}</h2>
    <ol class="topic-verses-list">
      {topicVerses.map((v) => (
        <li class="topic-verse">
          <p class="topic-verse-text">{v.text}</p>
          <p class="topic-verse-ref">
            <a href={`/verses/${v.id}/`}>{reference(v)}</a>
          </p>
        </li>
      ))}
    </ol>
    <p class="topic-verses-cta">Press “Generate Verse” above to draw a random verse on this topic.</p>
  </section>

  {topicFaq.length > 0 && (
    <section class="topic-faq">
      <h2>Frequently asked questions</h2>
      <div class="topic-faq-list">
        {topicFaq.map((f) => (
          <details class="topic-faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <section class="seo-content">
    <h2>About {topicLabel} Bible verses</h2>
    <p>
      {
        isOccasion ? (
          <>This page brings together Bible verses for {item.id.toLowerCase()} — {item.desc.toLowerCase()} Press
            “Generate Verse” to draw a random verse for this occasion, or pick a different topic or occasion from the
            lists below.</>
        ) : (
          <>This page brings together {item.slug} verses from the World English Bible (Protestant Edition), a
            public-domain modern English translation. Press “Generate Verse” to draw a random verse on this topic, or
            pick a different topic or occasion from the lists below.</>
        )
      }
    </p>

    <h2>More topics</h2>
    <ul>
      {THEMES.map((t) => (
        <li>
          <a href={`/${t.id.toLowerCase()}/`}>{t.id} Bible Verses</a>
        </li>
      ))}
    </ul>

    <h2>Bible verses for occasions</h2>
    <ul>
      {OCCASIONS.map((o) => (
        <li>
          <a href={`/${o.slug}/`}>{o.id} Bible Verses</a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
