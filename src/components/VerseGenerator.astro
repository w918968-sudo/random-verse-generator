---
import { THEMES, OCCASIONS, ui } from '../i18n/en.mjs';

interface Props {
  initialTheme?: string;
  initialOccasion?: string;
}

const { initialTheme = '', initialOccasion = '' } = Astro.props;
---

<div class="generator" data-initial-theme={initialTheme} data-initial-occasion={initialOccasion}>
  <div class="source-field">
    <label class="field-label" for="source-select">{ui.sourceLabel}</label>
    <select class="source-select" id="source-select">
      <option value="curated">{ui.sourceCurated}</option>
      <option value="wholeBible">{ui.sourceWholeBible}</option>
    </select>
  </div>

  <div class="topic-field" id="topic-field">
    <span class="field-label" id="topic-label">{ui.themeGroupLabel}</span>
    <button
      type="button"
      class="topic-trigger"
      id="topic-trigger"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-controls="topic-menu"
      aria-labelledby="topic-label"
    >
      <span id="topic-summary">{ui.allVerses}</span>
      <span class="topic-caret" aria-hidden="true">▾</span>
    </button>
    <div class="topic-menu" id="topic-menu" hidden>
      <label class="topic-option">
        <input type="checkbox" data-theme="All" checked />
        <span>{ui.allVerses}</span>
      </label>
      {THEMES.map((t) => (
        <label class="topic-option">
          <input type="checkbox" data-theme={t.id} />
          <span>{t.id}</span>
        </label>
      ))}
      <span class="topic-group">{ui.occasionGroupLabel}</span>
      {OCCASIONS.map((o) => (
        <label class="topic-option">
          <input type="checkbox" data-occasion={o.slug} />
          <span>{o.id}</span>
        </label>
      ))}
      <div class="topic-menu-actions">
        <button type="button" class="btn btn-secondary btn-sm" id="topic-clear">{ui.topicClear}</button>
        <button type="button" class="btn btn-primary btn-sm" id="topic-done">{ui.topicDone}</button>
      </div>
    </div>
  </div>
  <p class="topic-note" id="topic-note" hidden>{ui.topicWholeBibleNote}</p>

  <div class="action-row">
    <button type="button" class="btn btn-primary" id="generate-btn">
      {ui.generate.first}
    </button>
    <button type="button" class="btn btn-secondary" id="history-btn" aria-expanded="false" hidden>
      {ui.history}
    </button>
    <button type="button" class="btn btn-secondary" id="favorites-btn" aria-expanded="false">
      {ui.favorites}
    </button>
  </div>

  <section class="history-panel" id="history-panel" hidden>
    <h3>{ui.historyTitle}</h3>
    <ol class="history-list" id="history-list"></ol>
  </section>

  <section class="history-panel" id="favorites-panel" hidden>
    <h3>{ui.favoritesTitle}</h3>
    <div class="fav-toolbar" id="fav-toolbar" hidden>
      <label class="fav-filter-label" for="fav-filter">{ui.favoritesFilterLabel}</label>
      <select id="fav-filter" class="fav-filter"></select>
      <span class="fav-toolbar-spacer"></span>
      <button type="button" class="btn btn-secondary btn-sm" id="fav-export">{ui.favoritesExport}</button>
      <button type="button" class="btn btn-secondary btn-sm" id="fav-import">{ui.favoritesImport}</button>
      <input type="file" id="fav-import-input" accept="application/json,.json" hidden />
    </div>
    <p class="fav-empty" id="favorites-empty" hidden>{ui.favoritesEmpty}</p>
    <ul class="history-list" id="favorites-list"></ul>
  </section>

  <div class="guide" id="guide" role="status">
    <p>{ui.guide}</p>
  </div>

  <div class="result" id="result" hidden>
    <figure class="verse-card">
      <blockquote class="verse-text" id="verse-text"></blockquote>
      <figcaption class="verse-meta">
        <span class="badge" id="verse-theme" hidden></span>
        <span class="verse-ref" id="verse-ref"></span>
      </figcaption>
      <div class="verse-actions">
        <button type="button" class="btn btn-secondary" id="fav-btn" aria-pressed="false">
          {ui.favorite}
        </button>
        <button type="button" class="btn btn-secondary" id="copy-btn">{ui.result.copy}</button>
        <button type="button" class="btn btn-secondary" id="share-btn">{ui.result.share}</button>
        <button type="button" class="btn btn-secondary" id="image-btn">{ui.result.image}</button>
        <button type="button" class="btn btn-secondary" id="speak-btn" aria-pressed="false">
          {ui.result.readAloud}
        </button>
        <button type="button" class="btn btn-secondary" id="context-btn" aria-expanded="false">
          {ui.result.context}
        </button>
      </div>
    </figure>

    <section class="reflection" id="reflection" hidden aria-label={ui.reflection.title}>
      <h3 class="reflection-title">{ui.reflection.title}</h3>
      <p class="reflection-question" id="reflection-question"></p>
      <button type="button" class="btn btn-secondary btn-sm reflection-next" id="reflection-next">
        {ui.reflection.another}
      </button>
    </section>

    <section class="reading-panel" id="reading-panel" hidden aria-live="polite">
      <div id="reading-content"></div>
      <div class="verse-actions">
        <button type="button" class="btn btn-secondary" id="chapter-btn" hidden>
          {ui.result.fullChapter}
        </button>
        <button type="button" class="btn btn-secondary" id="collapse-btn" hidden>
          {ui.result.collapseChapter}
        </button>
      </div>
    </section>

    <section class="related" id="related" hidden aria-label={ui.related.title}>
      <h3 class="related-title">{ui.related.title}</h3>
      <p class="related-hint">{ui.related.hint}</p>
      <ul class="related-list" id="related-list"></ul>
    </section>

    <p class="copy-fallback" id="copy-fallback" hidden role="alert">{ui.result.copyFallback}</p>
    <p class="error" id="error" hidden role="alert"></p>
  </div>

  <div class="sr-only" id="sr-live" aria-live="polite"></div>
</div>

<script>
  import { OCCASIONS, ui } from '../i18n/en.mjs';
  import { currentTranslation, dataPaths } from '../lib/translations.mjs';
  import { questionsFor } from '../data/reflection-questions.mjs';

  const el = {
    generator: document.querySelector('.generator'),
    sourceSelect: document.getElementById('source-select'),
    topicField: document.getElementById('topic-field'),
    topicTrigger: document.getElementById('topic-trigger'),
    topicMenu: document.getElementById('topic-menu'),
    topicSummary: document.getElementById('topic-summary'),
    topicClear: document.getElementById('topic-clear'),
    topicDone: document.getElementById('topic-done'),
    topicNote: document.getElementById('topic-note'),
    generateBtn: document.getElementById('generate-btn'),
    historyBtn: document.getElementById('history-btn'),
    historyPanel: document.getElementById('history-panel'),
    historyList: document.getElementById('history-list'),
    favoritesBtn: document.getElementById('favorites-btn'),
    favoritesPanel: document.getElementById('favorites-panel'),
    favoritesList: document.getElementById('favorites-list'),
    favoritesEmpty: document.getElementById('favorites-empty'),
    favToolbar: document.getElementById('fav-toolbar'),
    favFilter: document.getElementById('fav-filter'),
    favExport: document.getElementById('fav-export'),
    favImport: document.getElementById('fav-import'),
    favImportInput: document.getElementById('fav-import-input'),
    guide: document.getElementById('guide'),
    result: document.getElementById('result'),
    verseText: document.getElementById('verse-text'),
    verseRef: document.getElementById('verse-ref'),
    verseTheme: document.getElementById('verse-theme'),
    favBtn: document.getElementById('fav-btn'),
    copyBtn: document.getElementById('copy-btn'),
    shareBtn: document.getElementById('share-btn'),
    imageBtn: document.getElementById('image-btn'),
    speakBtn: document.getElementById('speak-btn'),
    contextBtn: document.getElementById('context-btn'),
    reflection: document.getElementById('reflection'),
    reflectionQuestion: document.getElementById('reflection-question'),
    reflectionNext: document.getElementById('reflection-next'),
    panel: document.getElementById('reading-panel'),
    readingContent: document.getElementById('reading-content'),
    chapterBtn: document.getElementById('chapter-btn'),
    collapseBtn: document.getElementById('collapse-btn'),
    related: document.getElementById('related'),
    relatedList: document.getElementById('related-list'),
    copyFallback: document.getElementById('copy-fallback'),
    error: document.getElementById('error'),
    live: document.getElementById('sr-live'),
  };

  const themeInputs = Array.from(el.topicMenu.querySelectorAll('input[data-theme]'));
  const occasionInputs = Array.from(el.topicMenu.querySelectorAll('input[data-occasion]'));
  const OCCASION_DISPLAY = new Map(OCCASIONS.map((o) => [o.slug, o.id]));
  let verses = []; // library loaded from /data/verses.json
  let versesById = new Map(); // id -> verse (curated library)
  let related = null; // Map<id, string[]> from /data/related.json (null = not loaded)
  let reflectionQuestions = []; // current verse's matching prompts
  let reflectionIndex = -1; // index of the prompt currently shown
  let currentVerse = null; // { ...verse, usedTheme }
  const selectedThemes = new Set(); // empty = all themes
  const selectedOccasions = new Set(); // empty = all occasions
  let lastDrawnId = null;
  let chapterData = null;
  let panelState = 'closed'; // 'closed' | 'context' | 'chapter'
  let speaking = false;
  const HISTORY_MAX = 8;
  let history = []; // session-only recent draws (cleared on refresh)
  const FAVORITES_KEY = 'versewell.favorites';
  let favorites = []; // persisted in localStorage
  let favoriteFilter = ''; // tag slug filtering the favorites list ('' = all)
  const bags = new Map(); // poolKey -> shuffled verse objects
  let translation = currentTranslation(); // 'WEBP' | 'KJV'
  let source = 'curated'; // 'curated' | 'wholeBible'
  let bibleData = null; // { books, chapters } for the current translation
  let bibleChapters = []; // [{ bookId, chapter, len }] in canonical order
  let bibleLoading = null; // Promise | null
  const drawnWholeBible = new Set(); // passage keys drawn this round
  let wholeBibleTotal = 0; // total verse count (reset threshold)

  function track(name, params) {
    if (typeof window.gtag === 'function') window.gtag('event', name, params);
  }
  function announce(msg) {
    el.live.textContent = '';
    el.live.textContent = msg;
  }
  function clearError() {
    el.error.hidden = true;
    el.error.textContent = '';
  }
  function showError(msg) {
    el.error.textContent = msg;
    el.error.hidden = false;
  }

  function shuffled(arr) {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function poolKey() {
    const parts = [];
    if (selectedThemes.size) parts.push('t:' + [...selectedThemes].sort().join('|'));
    if (selectedOccasions.size) parts.push('o:' + [...selectedOccasions].sort().join('|'));
    return parts.length ? parts.join('#') : 'All';
  }

  function currentPool() {
    if (!selectedThemes.size && !selectedOccasions.size) return verses;
    return verses.filter((v) => {
      const themeOk = !selectedThemes.size || v.themes.some((t) => selectedThemes.has(t));
      const occasionOk = !selectedOccasions.size || (v.occasions || []).some((o) => selectedOccasions.has(o));
      return themeOk && occasionOk;
    });
  }

  function draw() {
    const key = poolKey();
    const pool = currentPool();
    if (!pool.length) return null;
    let bag = bags.get(key);
    if (!bag || bag.length === 0) {
      bag = shuffled(pool);
      if (lastDrawnId && bag.length > 1 && bag[bag.length - 1].id === lastDrawnId) {
        const swapIdx = Math.floor(Math.random() * (bag.length - 1));
        [bag[bag.length - 1], bag[swapIdx]] = [bag[swapIdx], bag[bag.length - 1]];
      }
      bags.set(key, bag);
    }
    const v = bag.pop();
    lastDrawnId = v.id;
    return v;
  }

  function reference(v) {
    const range = v.startVerse === v.endVerse ? String(v.startVerse) : `${v.startVerse}–${v.endVerse}`;
    return `${v.bookName} ${v.chapter}:${range}`;
  }

  function renderCard() {
    el.verseText.textContent = currentVerse.text;
    el.verseRef.textContent = reference(currentVerse);
    if (currentVerse.usedTheme) {
      el.verseTheme.hidden = false;
      el.verseTheme.textContent = currentVerse.usedTheme;
    } else {
      el.verseTheme.hidden = true;
    }
    renderFavButton();
    renderRelated();
    renderReflection();
  }

  function scrollToCardIfNeeded() {
    const rect = el.result.getBoundingClientRect();
    const vh = window.innerHeight || document.documentElement.clientHeight;
    if (rect.bottom < 0 || rect.top > vh) {
      el.result.scrollIntoView({ block: rect.top > vh ? 'start' : 'end' });
    }
  }

  function closeReading() {
    panelState = 'closed';
    el.panel.hidden = true;
    el.contextBtn.setAttribute('aria-expanded', 'false');
    el.chapterBtn.hidden = true;
    el.collapseBtn.hidden = true;
    el.readingContent.replaceChildren();
    chapterData = null;
  }

  async function generate() {
    let v;
    if (source === 'wholeBible') {
      try {
        await loadWholeBible();
      } catch {
        showError(ui.errors.chapterLoad);
        return;
      }
      v = drawWholeBible();
    } else {
      v = draw();
    }
    if (!v) {
      showError(ui.errors.themeUnavailable);
      return;
    }
    const matchedThemes = source === 'curated' && selectedThemes.size ? v.themes.filter((t) => selectedThemes.has(t)) : [];
    const matchedOccasions =
      source === 'curated' && selectedOccasions.size
        ? (v.occasions || []).filter((o) => selectedOccasions.has(o)).map((o) => OCCASION_DISPLAY.get(o) || o)
        : [];
    const used = [...matchedThemes, ...matchedOccasions];
    currentVerse = { ...v, usedTheme: used.length ? used.join(' · ') : null };
    closeReading();
    cancelSpeech();
    renderCard();
    history.unshift({ ...currentVerse });
    if (history.length > HISTORY_MAX) history.pop();
    renderHistory();
    clearError();
    el.result.hidden = false;
    el.guide.hidden = true;
    el.generateBtn.textContent = ui.generate.again;
    track('generate_verse');
    scrollToCardIfNeeded();
  }

  async function loadChapter(bookId, chapter) {
    const res = await fetch(`${dataPaths(translation).chaptersDir}/${bookId}/${chapter}.json`);
    if (!res.ok) throw new Error('chapter load failed');
    return res.json();
  }

  // Whole-Bible payload is loaded lazily on first use, per translation. It is
  // invalidated when the translation changes so we never mix WEBP/KJV text.
  function splitChapterKey(key) {
    const dot = key.lastIndexOf('.');
    return { bookId: key.slice(0, dot), chapter: Number(key.slice(dot + 1)) };
  }

  function passageKey(bookId, chapter, start, end) {
    return `${bookId}.${chapter}:${start}-${end}`;
  }

  function loadWholeBible() {
    if (bibleData) return Promise.resolve(bibleData);
    if (bibleLoading) return bibleLoading;
    bibleLoading = fetch(dataPaths(translation).bible)
      .then((r) => {
        if (!r.ok) throw new Error('bible load failed');
        return r.json();
      })
      .then((data) => {
        bibleChapters = Object.keys(data.chapters).map((key) => {
          const { bookId, chapter } = splitChapterKey(key);
          return { bookId, chapter, len: data.chapters[key].length };
        });
        wholeBibleTotal = bibleChapters.reduce((n, c) => n + c.len, 0);
        bibleData = data;
        bibleLoading = null;
        return data;
      })
      .catch((err) => {
        bibleLoading = null;
        throw err;
      });
    return bibleLoading;
  }

  function randomWholeBiblePassage() {
    const total = wholeBibleTotal;
    for (let attempt = 0; attempt < 24; attempt++) {
      let r = Math.floor(Math.random() * total);
      let ref = null;
      for (const c of bibleChapters) {
        if (r < c.len) {
          ref = c;
          break;
        }
        r -= c.len;
      }
      if (!ref) return null;
      const maxLen = Math.min(3, ref.len - r);
      const length = maxLen > 1 ? 1 + Math.floor(Math.random() * maxLen) : 1;
      const startVerse = r + 1;
      const endVerse = startVerse + length - 1;
      // A few verses are omitted (empty) in some translations — never draw one.
      const arr = bibleData.chapters[`${ref.bookId}.${ref.chapter}`];
      const text = arr.slice(startVerse - 1, endVerse).join(' ').trim();
      if (!text) continue;
      const key = passageKey(ref.bookId, ref.chapter, startVerse, endVerse);
      if (drawnWholeBible.has(key)) continue;
      return { key, ref, startVerse, endVerse, text };
    }
    return null;
  }

  function drawWholeBible() {
    if (!bibleData || !wholeBibleTotal) return null;
    let pick = randomWholeBiblePassage();
    if (!pick) {
      // Every start position has been used — start a fresh round.
      drawnWholeBible.clear();
      pick = randomWholeBiblePassage();
      if (!pick) return null;
    }
    drawnWholeBible.add(pick.key);
    if (drawnWholeBible.size >= wholeBibleTotal) drawnWholeBible.clear();
    return {
      id: pick.key,
      bookId: pick.ref.bookId,
      bookName: bibleData.books[pick.ref.bookId],
      chapter: pick.ref.chapter,
      startVerse: pick.startVerse,
      endVerse: pick.endVerse,
      text: pick.text,
      themes: [],
      translationId: translation,
    };
  }

  // Prefer the in-memory whole-Bible data when available (it covers every
  // chapter); otherwise fetch the curated chapter file.
  function getChapterData(bookId, chapter) {
    if (bibleData) {
      const arr = bibleData.chapters[`${bookId}.${chapter}`];
      if (arr) {
        return Promise.resolve({
          translationId: translation,
          bookId,
          bookName: bibleData.books[bookId],
          chapter,
          verses: arr.map((text, i) => ({ number: i + 1, text })),
        });
      }
    }
    return loadChapter(bookId, chapter);
  }

  function makeVerseRow(number, text, isCurrent) {
    const row = document.createElement('p');
    row.className = 'chapter-verse' + (isCurrent ? ' is-current' : '');
    row.id = `v-${number}`;
    const num = document.createElement('span');
    num.className = 'verse-num';
    num.textContent = String(number);
    const body = document.createElement('span');
    body.className = 'verse-body';
    body.textContent = text;
    row.append(num, body);
    return row;
  }

  function renderChapterPanel(chapter, range) {
    const frag = document.createDocumentFragment();
    chapter.verses.forEach((v) => {
      const isCurrent = v.number >= range.start && v.number <= range.end;
      frag.appendChild(makeVerseRow(v.number, v.text, isCurrent));
    });
    el.readingContent.replaceChildren(frag);
  }

  async function openContext() {
    if (!currentVerse) return;
    try {
      const chapter = await getChapterData(currentVerse.bookId, currentVerse.chapter);
      chapterData = chapter;
      const list = chapter.verses;
      const startIdx = list.findIndex((v) => v.number === currentVerse.startVerse);
      const endIdx = list.findIndex((v) => v.number === currentVerse.endVerse);
      const from = Math.max(0, startIdx - 2);
      const to = Math.min(list.length - 1, endIdx + 2);
      const slice = list.slice(from, to + 1);
      const frag = document.createDocumentFragment();
      slice.forEach((v) => {
        const isCurrent = v.number >= currentVerse.startVerse && v.number <= currentVerse.endVerse;
        frag.appendChild(makeVerseRow(v.number, v.text, isCurrent));
      });
      el.readingContent.replaceChildren(frag);
      panelState = 'context';
      el.panel.hidden = false;
      el.contextBtn.setAttribute('aria-expanded', 'true');
      el.chapterBtn.hidden = false;
      el.collapseBtn.hidden = true;
      track('open_context');
    } catch {
      showError(ui.errors.chapterLoad);
    }
  }

  function openFullChapter() {
    if (!chapterData || !currentVerse) return;
    renderChapterPanel(chapterData, {
      start: currentVerse.startVerse,
      end: currentVerse.endVerse,
    });
    panelState = 'chapter';
    el.chapterBtn.hidden = true;
    el.collapseBtn.hidden = false;
    track('open_chapter');
    requestAnimationFrame(() => {
      const first = document.getElementById(`v-${currentVerse.startVerse}`);
      if (first) first.scrollIntoView({ block: 'center' });
    });
  }

  function collapseChapter() {
    closeReading();
    el.result.scrollIntoView({ block: 'start' });
  }

  function applyUrlTheme() {
    const param = new URLSearchParams(location.search).get('theme');
    if (!param) return;
    selectedThemes.clear();
    for (const part of param.split(',')) {
      const input = themeInputs.find((i) => i.dataset.theme.toLowerCase() === part.trim().toLowerCase());
      if (input && input.dataset.theme !== 'All') selectedThemes.add(input.dataset.theme);
    }
    syncTopicUI();
  }

  function applyUrlOccasion() {
    const param = new URLSearchParams(location.search).get('occasion');
    if (!param) return;
    selectedOccasions.clear();
    for (const part of param.split(',')) {
      const input = occasionInputs.find((i) => i.dataset.occasion.toLowerCase() === part.trim().toLowerCase());
      if (input) selectedOccasions.add(input.dataset.occasion);
    }
    syncTopicUI();
  }

  function applyInitialTheme() {
    const t = el.generator.dataset.initialTheme;
    if (!t) return;
    // An explicit ?theme= in the URL takes precedence over the page's default.
    if (new URLSearchParams(location.search).get('theme')) return;
    const input = themeInputs.find((i) => i.dataset.theme.toLowerCase() === t.toLowerCase());
    if (input && input.dataset.theme !== 'All') selectedThemes.add(input.dataset.theme);
    syncTopicUI();
  }

  function applyInitialOccasion() {
    const o = el.generator.dataset.initialOccasion;
    if (!o) return;
    // An explicit ?occasion= in the URL takes precedence over the page's default.
    if (new URLSearchParams(location.search).get('occasion')) return;
    const input = occasionInputs.find((i) => i.dataset.occasion.toLowerCase() === o.toLowerCase());
    if (input) selectedOccasions.add(input.dataset.occasion);
    syncTopicUI();
  }

  async function shareVerse() {
    if (!currentVerse) return;
    const theme = selectedThemes.size ? [...selectedThemes].sort().join(',') : '';
    const occasion = selectedOccasions.size ? [...selectedOccasions].sort().join(',') : '';
    const qs = [theme && `theme=${encodeURIComponent(theme)}`, occasion && `occasion=${encodeURIComponent(occasion)}`]
      .filter(Boolean)
      .join('&');
    const url = `${location.origin}${location.pathname}${qs ? `?${qs}` : ''}`;
    const payload = { title: ui.brand, text: currentVerse.text, url };

    if (navigator.share) {
      try {
        await navigator.share(payload);
        track('share_verse');
        return;
      } catch (err) {
        if (err && err.name === 'AbortError') return; // user cancelled — nothing to do
        // otherwise fall through to copy-link fallback
      }
    }

    try {
      await navigator.clipboard.writeText(url);
      const original = el.shareBtn.textContent;
      el.shareBtn.textContent = ui.result.shareCopied;
      announce(ui.result.shareCopied);
      track('share_verse');
      setTimeout(() => {
        el.shareBtn.textContent = original;
      }, 2000);
    } catch {
      showError(ui.errors.shareFailed);
    }
  }

  let speechVoice = null;

  // Prefer a natural/neural English voice when the platform offers one.
  function pickSpeechVoice() {
    if (!('speechSynthesis' in window)) return;
    const voices = window.speechSynthesis.getVoices();
    const en = voices.filter((v) => v.lang && v.lang.toLowerCase().startsWith('en'));
    const pool = en.length ? en : voices;
    if (!pool.length) return;
    const natural = pool.find((v) => /natural|neural|enhanced|online/i.test(v.name));
    const enCore = pool.find((v) => /^en[-_](US|GB)/i.test(v.lang));
    speechVoice = natural || enCore || pool[0];
  }

  pickSpeechVoice();
  window.speechSynthesis?.addEventListener?.('voiceschanged', pickSpeechVoice);

  function setSpeaking(on) {
    speaking = on;
    el.speakBtn.textContent = on ? ui.result.stopReading : ui.result.readAloud;
    el.speakBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
  }

  function cancelSpeech() {
    if ('speechSynthesis' in window) window.speechSynthesis.cancel();
    setSpeaking(false);
  }

  function speakVerse() {
    if (!currentVerse || !('speechSynthesis' in window)) return;
    if (speaking) {
      cancelSpeech();
      return;
    }
    const utterance = new SpeechSynthesisUtterance(currentVerse.text);
    utterance.lang = 'en-US';
    utterance.rate = 0.85; // slower, more deliberate
    utterance.pitch = 0.9; // slightly deeper / more solemn
    if (speechVoice) utterance.voice = speechVoice;
    utterance.onend = () => setSpeaking(false);
    utterance.onerror = () => setSpeaking(false);
    setSpeaking(true);
    window.speechSynthesis.speak(utterance);
    track('read_aloud');
  }

  const SERIF = 'Georgia, "Times New Roman", serif';
  const SANS = 'system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif';

  function roundRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  function wrapLine(ctx, text, maxWidth) {
    const words = text.split(/\s+/);
    const lines = [];
    let line = '';
    for (const w of words) {
      const test = line ? `${line} ${w}` : w;
      if (line && ctx.measureText(test).width > maxWidth) {
        lines.push(line);
        line = w;
      } else {
        line = test;
      }
    }
    if (line) lines.push(line);
    return lines;
  }

  function wrapText(ctx, text, maxWidth) {
    const out = [];
    for (const para of text.split('\n')) {
      const p = para.trim();
      if (!p) {
        out.push('');
        continue;
      }
      out.push(...wrapLine(ctx, p, maxWidth));
    }
    return out;
  }

  async function renderVerseImage() {
    const W = 1080;
    const H = 1350;
    const padX = 110;
    const canvas = document.createElement('canvas');
    canvas.width = W;
    canvas.height = H;
    const ctx = canvas.getContext('2d');

    ctx.fillStyle = '#F7F3EA';
    ctx.fillRect(0, 0, W, H);

    // Top gold accent
    ctx.strokeStyle = '#C9A227';
    ctx.lineWidth = 6;
    ctx.beginPath();
    ctx.moveTo(W / 2 - 60, 120);
    ctx.lineTo(W / 2 + 60, 120);
    ctx.stroke();

    // Verse text — auto-shrink so long passages still fit.
    const textMaxWidth = W - padX * 2;
    const available = H - 240 - 340;
    let fontSize = 64;
    let lines;
    for (;;) {
      ctx.font = `${fontSize}px ${SERIF}`;
      lines = wrapText(ctx, currentVerse.text, textMaxWidth);
      const lineHeight = Math.round(fontSize * 1.5);
      if (lines.length * lineHeight <= available || fontSize <= 34) break;
      fontSize -= 4;
    }
    const lineHeight = Math.round(fontSize * 1.5);
    const blockH = lines.length * lineHeight;
    let y = (H - blockH) / 2 - 40;
    ctx.fillStyle = '#2B2620';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.font = `${fontSize}px ${SERIF}`;
    for (const line of lines) {
      if (line) ctx.fillText(line, W / 2, y + lineHeight / 2);
      y += lineHeight;
    }

    // Reference
    ctx.font = `600 42px ${SANS}`;
    ctx.fillStyle = '#8C4A2F';
    ctx.fillText(reference(currentVerse), W / 2, y + 60);

    // Theme badge
    if (currentVerse.usedTheme) {
      ctx.font = `600 38px ${SANS}`;
      const label = currentVerse.usedTheme;
      const bw = ctx.measureText(label).width + 64;
      const bh = 64;
      const bx = W / 2 - bw / 2;
      const by = y + 120;
      roundRect(ctx, bx, by, bw, bh, bh / 2);
      ctx.fillStyle = '#F1E5C9';
      ctx.fill();
      ctx.strokeStyle = '#C9A227';
      ctx.lineWidth = 3;
      ctx.stroke();
      ctx.fillStyle = '#2B2620';
      ctx.fillText(label, W / 2, by + bh / 2 + 2);
    }

    // Brand wordmark
    ctx.font = `700 42px ${SERIF}`;
    ctx.fillStyle = '#8C4A2F';
    ctx.fillText(ui.brand, W / 2, H - 120);
    ctx.strokeStyle = '#C9A227';
    ctx.lineWidth = 5;
    ctx.beginPath();
    ctx.moveTo(W / 2 - 70, H - 84);
    ctx.lineTo(W / 2 + 70, H - 84);
    ctx.stroke();

    return new Promise((resolve, reject) => {
      canvas.toBlob((blob) => (blob ? resolve(blob) : reject(new Error('toBlob failed'))), 'image/png');
    });
  }

  async function saveVerseImage() {
    if (!currentVerse) return;
    try {
      const blob = await renderVerseImage();
      const filename = `versewell-${currentVerse.bookId}-${currentVerse.chapter}-${currentVerse.startVerse}.png`;
      const file = new File([blob], filename, { type: 'image/png' });
      if (navigator.canShare && navigator.canShare({ files: [file] })) {
        try {
          await navigator.share({ files: [file], title: ui.brand });
          track('verse_image');
          return;
        } catch (err) {
          if (err && err.name === 'AbortError') return;
          // otherwise fall through to download
        }
      }
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      track('verse_image');
    } catch {
      showError(ui.errors.imageFailed);
    }
  }

  function closeHistory() {
    el.historyPanel.hidden = true;
    el.historyBtn.setAttribute('aria-expanded', 'false');
  }

  function renderHistory() {
    el.historyList.replaceChildren();
    history.forEach((item, i) => {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'history-item';
      btn.dataset.index = String(i);
      const ref = document.createElement('span');
      ref.className = 'history-ref';
      ref.textContent = reference(item);
      const text = document.createElement('span');
      text.className = 'history-text';
      const flat = item.text.replace(/\s+/g, ' ');
      text.textContent = flat.length > 120 ? flat.slice(0, 120) + '…' : flat;
      btn.append(ref, text);
      li.appendChild(btn);
      el.historyList.appendChild(li);
    });
    el.historyBtn.hidden = history.length === 0;
    if (!history.length) closeHistory();
  }

  function toggleHistory() {
    if (el.historyPanel.hidden) {
      renderHistory();
      el.historyPanel.hidden = false;
      el.historyBtn.setAttribute('aria-expanded', 'true');
    } else {
      closeHistory();
    }
  }

  function openHistoryItem(index) {
    const item = history[index];
    if (!item) return;
    currentVerse = { ...item };
    closeReading();
    cancelSpeech();
    renderCard();
    clearError();
    el.result.hidden = false;
    el.guide.hidden = true;
    el.generateBtn.textContent = ui.generate.again;
    closeHistory();
    el.result.scrollIntoView({ block: 'start' });
  }

  function loadFavorites() {
    try {
      const raw = localStorage.getItem(FAVORITES_KEY);
      favorites = raw ? JSON.parse(raw) : [];
    } catch {
      favorites = [];
    }
  }

  function saveFavorites() {
    try {
      localStorage.setItem(FAVORITES_KEY, JSON.stringify(favorites));
    } catch {
      // Storage full or unavailable — favorites just won't persist this time.
    }
  }

  function isFavorite(id) {
    return favorites.some((f) => f.id === id);
  }

  function renderFavButton() {
    if (!currentVerse) return;
    const on = isFavorite(currentVerse.id);
    el.favBtn.textContent = on ? ui.favoriteSaved : ui.favorite;
    el.favBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
  }

  // Related verses — a small "keep reading" list driven by /data/related.json.
  // Curated draws only: whole-Bible picks have no id in the related map, so the
  // section simply stays hidden.
  function loadRelated() {
    fetch('/data/related.json')
      .then((r) => r.json())
      .then((data) => {
        related = new Map(Object.entries(data.related || {}));
        renderRelated();
      })
      .catch(() => {
        related = new Map();
      });
  }

  function renderRelated() {
    el.related.hidden = true;
    el.relatedList.replaceChildren();
    if (!related || !currentVerse) return;
    const ids = related.get(currentVerse.id);
    if (!ids) return;
    const items = ids.map((id) => versesById.get(id)).filter(Boolean).slice(0, 3);
    if (!items.length) return;
    for (const v of items) {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'related-item';
      btn.dataset.id = v.id;
      const ref = document.createElement('span');
      ref.className = 'related-ref';
      ref.textContent = reference(v);
      const text = document.createElement('span');
      text.className = 'related-text';
      const flat = v.text.replace(/\s+/g, ' ');
      text.textContent = flat.length > 110 ? flat.slice(0, 110) + '…' : flat;
      btn.append(ref, text);
      li.appendChild(btn);
      el.relatedList.appendChild(li);
    }
    el.related.hidden = false;
  }

  // Reflection — a single "ponder this" prompt matched to the verse's themes
  // and occasions. Shown for both curated and whole-Bible draws (the latter
  // fall back to the general pool).
  function renderReflection() {
    el.reflection.hidden = true;
    if (!currentVerse) return;
    const qs = questionsFor(currentVerse);
    if (!qs.length) return;
    reflectionQuestions = qs;
    reflectionIndex = Math.floor(Math.random() * qs.length);
    el.reflectionQuestion.textContent = qs[reflectionIndex];
    el.reflection.hidden = false;
  }

  function toggleFavorite() {
    if (!currentVerse) return;
    const idx = favorites.findIndex((f) => f.id === currentVerse.id);
    if (idx >= 0) {
      favorites.splice(idx, 1);
    } else {
      favorites.unshift({
        id: currentVerse.id,
        bookId: currentVerse.bookId,
        bookName: currentVerse.bookName,
        chapter: currentVerse.chapter,
        startVerse: currentVerse.startVerse,
        endVerse: currentVerse.endVerse,
        text: currentVerse.text,
        themes: currentVerse.themes,
        occasions: currentVerse.occasions || [],
        usedTheme: currentVerse.usedTheme || currentVerse.themes.join(' · '),
        note: '',
      });
    }
    saveFavorites();
    renderFavButton();
    renderFavorites();
    track(idx >= 0 ? 'remove_favorite' : 'add_favorite');
  }

  function favoriteTags() {
    const tags = new Set();
    for (const f of favorites) {
      for (const t of f.themes || []) tags.add(t);
      for (const o of f.occasions || []) tags.add(o);
    }
    return [...tags].sort((a, b) => a.toLowerCase().localeCompare(b.toLowerCase()));
  }

  function tagLabel(slug) {
    return OCCASION_DISPLAY.get(slug) || slug;
  }

  function visibleFavorites() {
    if (!favoriteFilter) return favorites;
    return favorites.filter(
      (f) => (f.themes || []).includes(favoriteFilter) || (f.occasions || []).includes(favoriteFilter),
    );
  }

  function favoriteById(id) {
    return favorites.find((f) => f.id === id);
  }

  function findFavItemEl(id) {
    return el.favoritesList.querySelector(`li[data-id="${CSS.escape(id)}"]`);
  }

  function renderFavorites() {
    el.favoritesList.replaceChildren();
    const hasFavorites = favorites.length !== 0;
    el.favToolbar.hidden = !hasFavorites;
    el.favoritesEmpty.hidden = true;

    // Rebuild the tag filter, keeping the current selection when it still exists.
    const tags = favoriteTags();
    if (favoriteFilter && !tags.includes(favoriteFilter)) favoriteFilter = '';
    el.favFilter.replaceChildren();
    const all = document.createElement('option');
    all.value = '';
    all.textContent = ui.allVerses;
    el.favFilter.appendChild(all);
    for (const tag of tags) {
      const opt = document.createElement('option');
      opt.value = tag;
      opt.textContent = tagLabel(tag);
      el.favFilter.appendChild(opt);
    }
    el.favFilter.value = favoriteFilter;

    const list = visibleFavorites();
    if (!hasFavorites) {
      el.favoritesEmpty.textContent = ui.favoritesEmpty;
      el.favoritesEmpty.hidden = false;
      return;
    }
    if (!list.length) {
      el.favoritesEmpty.textContent = ui.favoritesFilterEmpty;
      el.favoritesEmpty.hidden = false;
      return;
    }

    list.forEach((item) => {
      const li = document.createElement('li');
      li.className = 'fav-item';
      li.dataset.id = item.id;

      const row = document.createElement('div');
      row.className = 'fav-row';

      const open = document.createElement('button');
      open.type = 'button';
      open.className = 'history-item';
      open.dataset.id = item.id;
      const ref = document.createElement('span');
      ref.className = 'history-ref';
      ref.textContent = reference(item);
      const text = document.createElement('span');
      text.className = 'history-text';
      const flat = item.text.replace(/\s+/g, ' ');
      text.textContent = flat.length > 120 ? flat.slice(0, 120) + '…' : flat;
      open.append(ref, text);

      const noteToggle = document.createElement('button');
      noteToggle.type = 'button';
      noteToggle.className = 'fav-note-toggle';
      noteToggle.dataset.id = item.id;
      noteToggle.setAttribute('aria-label', ui.favoriteNote);
      noteToggle.setAttribute('aria-pressed', item.note ? 'true' : 'false');
      noteToggle.textContent = ui.favoriteNote;
      if (item.note) noteToggle.classList.add('has-note');

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'fav-remove';
      remove.dataset.id = item.id;
      remove.setAttribute('aria-label', ui.favoriteRemove);
      remove.textContent = '×';

      row.append(open, noteToggle, remove);
      li.appendChild(row);

      const editor = document.createElement('div');
      editor.className = 'fav-note-editor';
      editor.hidden = true;
      const input = document.createElement('textarea');
      input.className = 'fav-note-input';
      input.rows = 2;
      input.placeholder = ui.favoriteNotePlaceholder;
      input.value = item.note || '';
      input.addEventListener('change', () => {
        const next = input.value.trim();
        if (next === (item.note || '')) return;
        item.note = next;
        saveFavorites();
        noteToggle.setAttribute('aria-pressed', next ? 'true' : 'false');
        noteToggle.classList.toggle('has-note', !!next);
        track('favorite_note_saved');
      });
      editor.appendChild(input);
      li.appendChild(editor);

      el.favoritesList.appendChild(li);
    });
  }

  function toggleNoteEditor(id) {
    const li = findFavItemEl(id);
    if (!li) return;
    const editor = li.querySelector('.fav-note-editor');
    const input = li.querySelector('.fav-note-input');
    if (!editor || !input) return;
    const willShow = editor.hidden;
    editor.hidden = !willShow;
    if (willShow) input.focus();
  }

  function exportFavorites() {
    if (!favorites.length) return;
    const payload = {
      app: 'versewell',
      type: 'favorites',
      version: 1,
      exportedAt: new Date().toISOString(),
      favorites,
    };
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `versewell-favorites-${new Date().toISOString().slice(0, 10)}.json`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
    track('favorites_export');
  }

  function importFavorites(file) {
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const data = JSON.parse(reader.result);
        const incoming = Array.isArray(data) ? data : Array.isArray(data?.favorites) ? data.favorites : null;
        if (!incoming) throw new Error('shape');
        const byId = new Map(favorites.map((f) => [f.id, f]));
        let added = 0;
        for (const raw of incoming) {
          if (!raw || typeof raw.id !== 'string' || typeof raw.text !== 'string' || typeof raw.bookName !== 'string') continue;
          if (byId.has(raw.id)) continue; // keep the local copy (and its note)
          byId.set(raw.id, {
            id: raw.id,
            bookId: raw.bookId,
            bookName: raw.bookName,
            chapter: raw.chapter,
            startVerse: raw.startVerse,
            endVerse: raw.endVerse,
            text: raw.text,
            themes: Array.isArray(raw.themes) ? raw.themes : [],
            occasions: Array.isArray(raw.occasions) ? raw.occasions : [],
            usedTheme: raw.usedTheme,
            note: typeof raw.note === 'string' ? raw.note : '',
          });
          added++;
        }
        favorites = [...byId.values()];
        saveFavorites();
        renderFavorites();
        renderFavButton();
        track('favorites_import');
        announce(ui.favoritesImportDone(added));
      } catch {
        showError(ui.favoritesImportInvalid);
      }
    };
    reader.readAsText(file);
    el.favImportInput.value = '';
  }

  function closeFavorites() {
    el.favoritesPanel.hidden = true;
    el.favoritesBtn.setAttribute('aria-expanded', 'false');
  }

  function toggleFavorites() {
    if (el.favoritesPanel.hidden) {
      renderFavorites();
      el.favoritesPanel.hidden = false;
      el.favoritesBtn.setAttribute('aria-expanded', 'true');
    } else {
      closeFavorites();
    }
  }

  function openFavoriteItem(id) {
    const item = favoriteById(id);
    if (!item) return;
    currentVerse = { ...item };
    closeReading();
    cancelSpeech();
    renderCard();
    clearError();
    el.result.hidden = false;
    el.guide.hidden = true;
    el.generateBtn.textContent = ui.generate.again;
    closeFavorites();
    el.result.scrollIntoView({ block: 'start' });
  }

  // Wire up events
  function updateTopicSummary() {
    const n = selectedThemes.size + selectedOccasions.size;
    el.topicSummary.textContent = n ? ui.topicSelected(n) : ui.allVerses;
  }

  function syncTopicUI() {
    for (const input of themeInputs) {
      const id = input.dataset.theme;
      input.checked = id === 'All' ? selectedThemes.size === 0 && selectedOccasions.size === 0 : selectedThemes.has(id);
    }
    for (const input of occasionInputs) {
      input.checked = selectedOccasions.has(input.dataset.occasion);
    }
    updateTopicSummary();
  }

  function openTopicMenu() {
    el.topicMenu.hidden = false;
    el.topicTrigger.setAttribute('aria-expanded', 'true');
  }

  function closeTopicMenu() {
    el.topicMenu.hidden = true;
    el.topicTrigger.setAttribute('aria-expanded', 'false');
  }

  function syncSourceUI() {
    const whole = source === 'wholeBible';
    el.topicTrigger.disabled = whole;
    el.topicNote.hidden = !whole;
    closeTopicMenu();
  }

  el.topicTrigger.addEventListener('click', () => {
    if (el.topicTrigger.disabled) return;
    if (el.topicMenu.hidden) openTopicMenu();
    else closeTopicMenu();
  });

  el.topicMenu.addEventListener('change', (e) => {
    const themeInput = e.target.closest('input[data-theme]');
    const occasionInput = e.target.closest('input[data-occasion]');
    if (themeInput) {
      const id = themeInput.dataset.theme;
      if (id === 'All') {
        selectedThemes.clear();
        selectedOccasions.clear();
      } else if (themeInput.checked) selectedThemes.add(id);
      else selectedThemes.delete(id);
    } else if (occasionInput) {
      const slug = occasionInput.dataset.occasion;
      if (occasionInput.checked) selectedOccasions.add(slug);
      else selectedOccasions.delete(slug);
    } else {
      return;
    }
    syncTopicUI();
    track('select_theme');
  });

  el.topicClear.addEventListener('click', () => {
    selectedThemes.clear();
    selectedOccasions.clear();
    syncTopicUI();
    track('select_theme');
  });

  el.topicDone.addEventListener('click', closeTopicMenu);

  document.addEventListener('click', (e) => {
    if (!el.topicMenu.hidden && !el.topicField.contains(e.target)) closeTopicMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !el.topicMenu.hidden) {
      closeTopicMenu();
      el.topicTrigger.focus();
    }
  });

  el.sourceSelect.addEventListener('change', () => {
    source = el.sourceSelect.value;
    syncSourceUI();
    track('change_source', { value: source });
    generate();
  });

  el.generateBtn.addEventListener('click', generate);
  el.historyBtn.addEventListener('click', toggleHistory);
  el.historyList.addEventListener('click', (e) => {
    const btn = e.target.closest('.history-item');
    if (btn) openHistoryItem(Number(btn.dataset.index));
  });

  el.favBtn.addEventListener('click', toggleFavorite);
  el.favoritesBtn.addEventListener('click', toggleFavorites);
  el.favoritesList.addEventListener('click', (e) => {
    const removeBtn = e.target.closest('.fav-remove');
    if (removeBtn) {
      favorites = favorites.filter((f) => f.id !== removeBtn.dataset.id);
      saveFavorites();
      renderFavorites();
      renderFavButton();
      track('remove_favorite');
      return;
    }
    const noteBtn = e.target.closest('.fav-note-toggle');
    if (noteBtn) {
      toggleNoteEditor(noteBtn.dataset.id);
      return;
    }
    const openBtn = e.target.closest('.history-item');
    if (openBtn) openFavoriteItem(openBtn.dataset.id);
  });
  el.favFilter.addEventListener('change', () => {
    favoriteFilter = el.favFilter.value;
    renderFavorites();
  });
  el.favExport.addEventListener('click', exportFavorites);
  el.favImport.addEventListener('click', () => el.favImportInput.click());
  el.favImportInput.addEventListener('change', () => importFavorites(el.favImportInput.files[0]));

  el.shareBtn.addEventListener('click', shareVerse);
  el.imageBtn.addEventListener('click', saveVerseImage);

  el.relatedList.addEventListener('click', (e) => {
    const btn = e.target.closest('.related-item');
    if (!btn) return;
    const v = versesById.get(btn.dataset.id);
    if (!v) return;
    currentVerse = { ...v, usedTheme: v.themes.length ? v.themes.join(' · ') : null };
    closeReading();
    cancelSpeech();
    renderCard();
    clearError();
    el.result.hidden = false;
    el.guide.hidden = true;
    el.generateBtn.textContent = ui.generate.again;
    track('related_verse_click');
    el.result.scrollIntoView({ block: 'start' });
  });

  el.reflectionNext.addEventListener('click', () => {
    if (reflectionQuestions.length < 2) return;
    let next;
    do {
      next = Math.floor(Math.random() * reflectionQuestions.length);
    } while (next === reflectionIndex);
    reflectionIndex = next;
    el.reflectionQuestion.textContent = reflectionQuestions[next];
    track('reflection_question_click');
  });

  if ('speechSynthesis' in window) {
    el.speakBtn.addEventListener('click', speakVerse);
  } else {
    el.speakBtn.hidden = true;
  }

  el.copyBtn.addEventListener('click', async () => {
    if (!currentVerse) return;
    try {
      await navigator.clipboard.writeText(currentVerse.text);
      const original = ui.result.copy;
      el.copyBtn.textContent = ui.result.copied;
      el.copyFallback.hidden = true;
      announce(ui.result.copied);
      track('copy_verse');
      setTimeout(() => {
        el.copyBtn.textContent = original;
      }, 2000);
    } catch {
      el.copyFallback.hidden = false;
    }
  });

  el.contextBtn.addEventListener('click', () => {
    if (panelState === 'context' || panelState === 'chapter') {
      closeReading();
      return;
    }
    openContext();
  });

  el.chapterBtn.addEventListener('click', openFullChapter);
  el.collapseBtn.addEventListener('click', collapseChapter);

  function loadLibrary(initial) {
    el.guide.hidden = false;
    el.result.hidden = true;
    el.generateBtn.textContent = ui.generate.first;
    fetch(dataPaths(translation).verses)
      .then((r) => r.json())
      .then((data) => {
        verses = data;
        versesById = new Map(data.map((v) => [v.id, v]));
        const curatedOption = el.sourceSelect.querySelector('option[value="curated"]');
        if (curatedOption) curatedOption.textContent = ui.sourceCuratedFull(data.length);
        bags.clear();
        history = [];
        renderHistory();
        if (initial) {
          applyUrlTheme();
          applyUrlOccasion();
          applyInitialTheme();
          applyInitialOccasion();
        }
        generate();
      })
      .catch(() => {
        showError(ui.errors.chapterLoad);
      });
  }

  window.addEventListener('translationchange', (e) => {
    if (!e.detail || e.detail === translation) return;
    translation = e.detail;
    // Whole-Bible data is translation-specific — drop the cache so the next
    // generate() reloads it in the new translation.
    bibleData = null;
    bibleChapters = [];
    bibleLoading = null;
    drawnWholeBible.clear();
    wholeBibleTotal = 0;
    loadLibrary(false);
  });

  // Load the verse library, then show a verse right away. Related-verses data
  // is translation-independent, so it is fetched once and never re-read.
  loadFavorites();
  loadRelated();
  loadLibrary(true);
</script>
