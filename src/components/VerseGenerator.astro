---
import { THEMES, ui } from '../i18n/en.mjs';

interface Props {
  initialTheme?: string;
}

const { initialTheme = '' } = Astro.props;

const themeButtons = [{ id: 'All', label: ui.allVerses }, ...THEMES.map((t) => ({ id: t.id, label: t.id }))];
---

<div class="generator" data-initial-theme={initialTheme}>
  <div class="theme-group" role="group" aria-label={ui.themeGroupLabel}>
    {themeButtons.map((t) => (
      <button
        type="button"
        class="theme-btn"
        data-theme={t.id}
        aria-pressed={t.id === 'All' ? 'true' : 'false'}
      >
        {t.label}
      </button>
    ))}
  </div>

  <div class="action-row">
    <button type="button" class="btn btn-primary" id="generate-btn">
      {ui.generate.first}
    </button>
    <button type="button" class="btn btn-secondary" id="history-btn" aria-expanded="false" hidden>
      {ui.history}
    </button>
    <button type="button" class="btn btn-secondary" id="favorites-btn" aria-expanded="false">
      {ui.favorites}
    </button>
  </div>

  <section class="history-panel" id="history-panel" hidden>
    <h3>{ui.historyTitle}</h3>
    <ol class="history-list" id="history-list"></ol>
  </section>

  <section class="history-panel" id="favorites-panel" hidden>
    <h3>{ui.favoritesTitle}</h3>
    <p class="fav-empty" id="favorites-empty" hidden>{ui.favoritesEmpty}</p>
    <ul class="history-list" id="favorites-list"></ul>
  </section>

  <div class="guide" id="guide" role="status">
    <p>{ui.guide}</p>
  </div>

  <div class="result" id="result" hidden>
    <figure class="verse-card">
      <blockquote class="verse-text" id="verse-text"></blockquote>
      <figcaption class="verse-meta">
        <span class="badge" id="verse-theme" hidden></span>
        <span class="verse-ref" id="verse-ref"></span>
      </figcaption>
      <div class="verse-actions">
        <button type="button" class="btn btn-secondary" id="fav-btn" aria-pressed="false">
          {ui.favorite}
        </button>
        <button type="button" class="btn btn-secondary" id="copy-btn">{ui.result.copy}</button>
        <button type="button" class="btn btn-secondary" id="share-btn">{ui.result.share}</button>
        <button type="button" class="btn btn-secondary" id="image-btn">{ui.result.image}</button>
        <button type="button" class="btn btn-secondary" id="speak-btn" aria-pressed="false">
          {ui.result.readAloud}
        </button>
        <button type="button" class="btn btn-secondary" id="context-btn" aria-expanded="false">
          {ui.result.context}
        </button>
      </div>
    </figure>

    <section class="reading-panel" id="reading-panel" hidden aria-live="polite">
      <div id="reading-content"></div>
      <div class="verse-actions">
        <button type="button" class="btn btn-secondary" id="chapter-btn" hidden>
          {ui.result.fullChapter}
        </button>
        <button type="button" class="btn btn-secondary" id="collapse-btn" hidden>
          {ui.result.collapseChapter}
        </button>
      </div>
    </section>

    <p class="copy-fallback" id="copy-fallback" hidden role="alert">{ui.result.copyFallback}</p>
    <p class="error" id="error" hidden role="alert"></p>
  </div>

  <div class="sr-only" id="sr-live" aria-live="polite"></div>
</div>

<script>
  import { ui } from '../i18n/en.mjs';
  import { currentTranslation, dataPaths } from '../lib/translations.mjs';

  const el = {
    generator: document.querySelector('.generator'),
    themeGroup: document.querySelector('.theme-group'),
    generateBtn: document.getElementById('generate-btn'),
    historyBtn: document.getElementById('history-btn'),
    historyPanel: document.getElementById('history-panel'),
    historyList: document.getElementById('history-list'),
    favoritesBtn: document.getElementById('favorites-btn'),
    favoritesPanel: document.getElementById('favorites-panel'),
    favoritesList: document.getElementById('favorites-list'),
    favoritesEmpty: document.getElementById('favorites-empty'),
    guide: document.getElementById('guide'),
    result: document.getElementById('result'),
    verseText: document.getElementById('verse-text'),
    verseRef: document.getElementById('verse-ref'),
    verseTheme: document.getElementById('verse-theme'),
    favBtn: document.getElementById('fav-btn'),
    copyBtn: document.getElementById('copy-btn'),
    shareBtn: document.getElementById('share-btn'),
    imageBtn: document.getElementById('image-btn'),
    speakBtn: document.getElementById('speak-btn'),
    contextBtn: document.getElementById('context-btn'),
    panel: document.getElementById('reading-panel'),
    readingContent: document.getElementById('reading-content'),
    chapterBtn: document.getElementById('chapter-btn'),
    collapseBtn: document.getElementById('collapse-btn'),
    copyFallback: document.getElementById('copy-fallback'),
    error: document.getElementById('error'),
    live: document.getElementById('sr-live'),
  };

  const themeButtons = Array.from(el.themeGroup.querySelectorAll('.theme-btn'));
  let verses = []; // library loaded from /data/verses.json
  let currentVerse = null; // { ...verse, usedTheme }
  const selectedThemes = new Set(); // empty = all themes
  let lastDrawnId = null;
  let chapterData = null;
  let panelState = 'closed'; // 'closed' | 'context' | 'chapter'
  let speaking = false;
  const HISTORY_MAX = 8;
  let history = []; // session-only recent draws (cleared on refresh)
  const FAVORITES_KEY = 'versewell.favorites';
  let favorites = []; // persisted in localStorage
  const bags = new Map(); // poolKey -> shuffled verse objects
  let translation = currentTranslation(); // 'WEBP' | 'KJV'

  function track(name, params) {
    if (typeof window.gtag === 'function') window.gtag('event', name, params);
  }
  function announce(msg) {
    el.live.textContent = '';
    el.live.textContent = msg;
  }
  function clearError() {
    el.error.hidden = true;
    el.error.textContent = '';
  }
  function showError(msg) {
    el.error.textContent = msg;
    el.error.hidden = false;
  }

  function shuffled(arr) {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function poolKey() {
    return selectedThemes.size ? [...selectedThemes].sort().join('|') : 'All';
  }

  function currentPool() {
    if (!selectedThemes.size) return verses;
    return verses.filter((v) => v.themes.some((t) => selectedThemes.has(t)));
  }

  function draw() {
    const key = poolKey();
    const pool = currentPool();
    if (!pool.length) return null;
    let bag = bags.get(key);
    if (!bag || bag.length === 0) {
      bag = shuffled(pool);
      if (lastDrawnId && bag.length > 1 && bag[bag.length - 1].id === lastDrawnId) {
        const swapIdx = Math.floor(Math.random() * (bag.length - 1));
        [bag[bag.length - 1], bag[swapIdx]] = [bag[swapIdx], bag[bag.length - 1]];
      }
      bags.set(key, bag);
    }
    const v = bag.pop();
    lastDrawnId = v.id;
    return v;
  }

  function reference(v) {
    const range = v.startVerse === v.endVerse ? String(v.startVerse) : `${v.startVerse}–${v.endVerse}`;
    return `${v.bookName} ${v.chapter}:${range}`;
  }

  function renderCard() {
    el.verseText.textContent = currentVerse.text;
    el.verseRef.textContent = reference(currentVerse);
    if (currentVerse.usedTheme) {
      el.verseTheme.hidden = false;
      el.verseTheme.textContent = currentVerse.usedTheme;
    } else {
      el.verseTheme.hidden = true;
    }
    renderFavButton();
  }

  function scrollToCardIfNeeded() {
    const rect = el.result.getBoundingClientRect();
    const vh = window.innerHeight || document.documentElement.clientHeight;
    if (rect.bottom < 0 || rect.top > vh) {
      el.result.scrollIntoView({ block: rect.top > vh ? 'start' : 'end' });
    }
  }

  function closeReading() {
    panelState = 'closed';
    el.panel.hidden = true;
    el.contextBtn.setAttribute('aria-expanded', 'false');
    el.chapterBtn.hidden = true;
    el.collapseBtn.hidden = true;
    el.readingContent.replaceChildren();
    chapterData = null;
  }

  function generate() {
    if (!verses.length) {
      showError(ui.errors.themeUnavailable);
      return;
    }
    const v = draw();
    if (!v) {
      showError(ui.errors.themeUnavailable);
      return;
    }
    const matched = selectedThemes.size ? v.themes.filter((t) => selectedThemes.has(t)) : [];
    currentVerse = { ...v, usedTheme: matched.length ? matched.join(' · ') : null };
    closeReading();
    cancelSpeech();
    renderCard();
    history.unshift({ ...currentVerse });
    if (history.length > HISTORY_MAX) history.pop();
    renderHistory();
    clearError();
    el.result.hidden = false;
    el.guide.hidden = true;
    el.generateBtn.textContent = ui.generate.again;
    track('generate_verse');
    scrollToCardIfNeeded();
  }

  async function loadChapter(bookId, chapter) {
    const res = await fetch(`${dataPaths(translation).chaptersDir}/${bookId}/${chapter}.json`);
    if (!res.ok) throw new Error('chapter load failed');
    return res.json();
  }

  function makeVerseRow(number, text, isCurrent) {
    const row = document.createElement('p');
    row.className = 'chapter-verse' + (isCurrent ? ' is-current' : '');
    row.id = `v-${number}`;
    const num = document.createElement('span');
    num.className = 'verse-num';
    num.textContent = String(number);
    const body = document.createElement('span');
    body.className = 'verse-body';
    body.textContent = text;
    row.append(num, body);
    return row;
  }

  function renderChapterPanel(chapter, range) {
    const frag = document.createDocumentFragment();
    chapter.verses.forEach((v) => {
      const isCurrent = v.number >= range.start && v.number <= range.end;
      frag.appendChild(makeVerseRow(v.number, v.text, isCurrent));
    });
    el.readingContent.replaceChildren(frag);
  }

  async function openContext() {
    if (!currentVerse) return;
    try {
      const chapter = await loadChapter(currentVerse.bookId, currentVerse.chapter);
      chapterData = chapter;
      const list = chapter.verses;
      const startIdx = list.findIndex((v) => v.number === currentVerse.startVerse);
      const endIdx = list.findIndex((v) => v.number === currentVerse.endVerse);
      const from = Math.max(0, startIdx - 2);
      const to = Math.min(list.length - 1, endIdx + 2);
      const slice = list.slice(from, to + 1);
      const frag = document.createDocumentFragment();
      slice.forEach((v) => {
        const isCurrent = v.number >= currentVerse.startVerse && v.number <= currentVerse.endVerse;
        frag.appendChild(makeVerseRow(v.number, v.text, isCurrent));
      });
      el.readingContent.replaceChildren(frag);
      panelState = 'context';
      el.panel.hidden = false;
      el.contextBtn.setAttribute('aria-expanded', 'true');
      el.chapterBtn.hidden = false;
      el.collapseBtn.hidden = true;
      track('open_context');
    } catch {
      showError(ui.errors.chapterLoad);
    }
  }

  function openFullChapter() {
    if (!chapterData || !currentVerse) return;
    renderChapterPanel(chapterData, {
      start: currentVerse.startVerse,
      end: currentVerse.endVerse,
    });
    panelState = 'chapter';
    el.chapterBtn.hidden = true;
    el.collapseBtn.hidden = false;
    track('open_chapter');
    requestAnimationFrame(() => {
      const first = document.getElementById(`v-${currentVerse.startVerse}`);
      if (first) first.scrollIntoView({ block: 'center' });
    });
  }

  function collapseChapter() {
    closeReading();
    el.result.scrollIntoView({ block: 'start' });
  }

  function applyUrlTheme() {
    const param = new URLSearchParams(location.search).get('theme');
    if (!param) return;
    selectedThemes.clear();
    for (const part of param.split(',')) {
      const btn = themeButtons.find((b) => b.dataset.theme.toLowerCase() === part.trim().toLowerCase());
      if (btn && btn.dataset.theme !== 'All') selectedThemes.add(btn.dataset.theme);
    }
    syncThemeButtons();
  }

  function applyInitialTheme() {
    const t = el.generator.dataset.initialTheme;
    if (!t) return;
    // An explicit ?theme= in the URL takes precedence over the page's default.
    if (new URLSearchParams(location.search).get('theme')) return;
    const btn = themeButtons.find((b) => b.dataset.theme.toLowerCase() === t.toLowerCase());
    if (btn && btn.dataset.theme !== 'All') selectedThemes.add(btn.dataset.theme);
    syncThemeButtons();
  }

  async function shareVerse() {
    if (!currentVerse) return;
    const theme = selectedThemes.size ? [...selectedThemes].sort().join(',') : '';
    const url = `${location.origin}${location.pathname}${theme ? `?theme=${encodeURIComponent(theme)}` : ''}`;
    const payload = { title: ui.brand, text: currentVerse.text, url };

    if (navigator.share) {
      try {
        await navigator.share(payload);
        track('share_verse');
        return;
      } catch (err) {
        if (err && err.name === 'AbortError') return; // user cancelled — nothing to do
        // otherwise fall through to copy-link fallback
      }
    }

    try {
      await navigator.clipboard.writeText(url);
      const original = el.shareBtn.textContent;
      el.shareBtn.textContent = ui.result.shareCopied;
      announce(ui.result.shareCopied);
      track('share_verse');
      setTimeout(() => {
        el.shareBtn.textContent = original;
      }, 2000);
    } catch {
      showError(ui.errors.shareFailed);
    }
  }

  let speechVoice = null;

  // Prefer a natural/neural English voice when the platform offers one.
  function pickSpeechVoice() {
    if (!('speechSynthesis' in window)) return;
    const voices = window.speechSynthesis.getVoices();
    const en = voices.filter((v) => v.lang && v.lang.toLowerCase().startsWith('en'));
    const pool = en.length ? en : voices;
    if (!pool.length) return;
    const natural = pool.find((v) => /natural|neural|enhanced|online/i.test(v.name));
    const enCore = pool.find((v) => /^en[-_](US|GB)/i.test(v.lang));
    speechVoice = natural || enCore || pool[0];
  }

  pickSpeechVoice();
  window.speechSynthesis?.addEventListener?.('voiceschanged', pickSpeechVoice);

  function setSpeaking(on) {
    speaking = on;
    el.speakBtn.textContent = on ? ui.result.stopReading : ui.result.readAloud;
    el.speakBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
  }

  function cancelSpeech() {
    if ('speechSynthesis' in window) window.speechSynthesis.cancel();
    setSpeaking(false);
  }

  function speakVerse() {
    if (!currentVerse || !('speechSynthesis' in window)) return;
    if (speaking) {
      cancelSpeech();
      return;
    }
    const utterance = new SpeechSynthesisUtterance(currentVerse.text);
    utterance.lang = 'en-US';
    utterance.rate = 0.85; // slower, more deliberate
    utterance.pitch = 0.9; // slightly deeper / more solemn
    if (speechVoice) utterance.voice = speechVoice;
    utterance.onend = () => setSpeaking(false);
    utterance.onerror = () => setSpeaking(false);
    setSpeaking(true);
    window.speechSynthesis.speak(utterance);
    track('read_aloud');
  }

  const SERIF = 'Georgia, "Times New Roman", serif';
  const SANS = 'system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif';

  function roundRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  function wrapLine(ctx, text, maxWidth) {
    const words = text.split(/\s+/);
    const lines = [];
    let line = '';
    for (const w of words) {
      const test = line ? `${line} ${w}` : w;
      if (line && ctx.measureText(test).width > maxWidth) {
        lines.push(line);
        line = w;
      } else {
        line = test;
      }
    }
    if (line) lines.push(line);
    return lines;
  }

  function wrapText(ctx, text, maxWidth) {
    const out = [];
    for (const para of text.split('\n')) {
      const p = para.trim();
      if (!p) {
        out.push('');
        continue;
      }
      out.push(...wrapLine(ctx, p, maxWidth));
    }
    return out;
  }

  async function renderVerseImage() {
    const W = 1080;
    const H = 1350;
    const padX = 110;
    const canvas = document.createElement('canvas');
    canvas.width = W;
    canvas.height = H;
    const ctx = canvas.getContext('2d');

    ctx.fillStyle = '#F7F3EA';
    ctx.fillRect(0, 0, W, H);

    // Top gold accent
    ctx.strokeStyle = '#C9A227';
    ctx.lineWidth = 6;
    ctx.beginPath();
    ctx.moveTo(W / 2 - 60, 120);
    ctx.lineTo(W / 2 + 60, 120);
    ctx.stroke();

    // Verse text — auto-shrink so long passages still fit.
    const textMaxWidth = W - padX * 2;
    const available = H - 240 - 340;
    let fontSize = 64;
    let lines;
    for (;;) {
      ctx.font = `${fontSize}px ${SERIF}`;
      lines = wrapText(ctx, currentVerse.text, textMaxWidth);
      const lineHeight = Math.round(fontSize * 1.5);
      if (lines.length * lineHeight <= available || fontSize <= 34) break;
      fontSize -= 4;
    }
    const lineHeight = Math.round(fontSize * 1.5);
    const blockH = lines.length * lineHeight;
    let y = (H - blockH) / 2 - 40;
    ctx.fillStyle = '#2B2620';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.font = `${fontSize}px ${SERIF}`;
    for (const line of lines) {
      if (line) ctx.fillText(line, W / 2, y + lineHeight / 2);
      y += lineHeight;
    }

    // Reference
    ctx.font = `600 42px ${SANS}`;
    ctx.fillStyle = '#8C4A2F';
    ctx.fillText(reference(currentVerse), W / 2, y + 60);

    // Theme badge
    if (currentVerse.usedTheme) {
      ctx.font = `600 38px ${SANS}`;
      const label = currentVerse.usedTheme;
      const bw = ctx.measureText(label).width + 64;
      const bh = 64;
      const bx = W / 2 - bw / 2;
      const by = y + 120;
      roundRect(ctx, bx, by, bw, bh, bh / 2);
      ctx.fillStyle = '#F1E5C9';
      ctx.fill();
      ctx.strokeStyle = '#C9A227';
      ctx.lineWidth = 3;
      ctx.stroke();
      ctx.fillStyle = '#2B2620';
      ctx.fillText(label, W / 2, by + bh / 2 + 2);
    }

    // Brand wordmark
    ctx.font = `700 42px ${SERIF}`;
    ctx.fillStyle = '#8C4A2F';
    ctx.fillText(ui.brand, W / 2, H - 120);
    ctx.strokeStyle = '#C9A227';
    ctx.lineWidth = 5;
    ctx.beginPath();
    ctx.moveTo(W / 2 - 70, H - 84);
    ctx.lineTo(W / 2 + 70, H - 84);
    ctx.stroke();

    return new Promise((resolve, reject) => {
      canvas.toBlob((blob) => (blob ? resolve(blob) : reject(new Error('toBlob failed'))), 'image/png');
    });
  }

  async function saveVerseImage() {
    if (!currentVerse) return;
    try {
      const blob = await renderVerseImage();
      const filename = `versewell-${currentVerse.bookId}-${currentVerse.chapter}-${currentVerse.startVerse}.png`;
      const file = new File([blob], filename, { type: 'image/png' });
      if (navigator.canShare && navigator.canShare({ files: [file] })) {
        try {
          await navigator.share({ files: [file], title: ui.brand });
          track('verse_image');
          return;
        } catch (err) {
          if (err && err.name === 'AbortError') return;
          // otherwise fall through to download
        }
      }
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      track('verse_image');
    } catch {
      showError(ui.errors.imageFailed);
    }
  }

  function closeHistory() {
    el.historyPanel.hidden = true;
    el.historyBtn.setAttribute('aria-expanded', 'false');
  }

  function renderHistory() {
    el.historyList.replaceChildren();
    history.forEach((item, i) => {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'history-item';
      btn.dataset.index = String(i);
      const ref = document.createElement('span');
      ref.className = 'history-ref';
      ref.textContent = reference(item);
      const text = document.createElement('span');
      text.className = 'history-text';
      const flat = item.text.replace(/\s+/g, ' ');
      text.textContent = flat.length > 120 ? flat.slice(0, 120) + '…' : flat;
      btn.append(ref, text);
      li.appendChild(btn);
      el.historyList.appendChild(li);
    });
    el.historyBtn.hidden = history.length === 0;
    if (!history.length) closeHistory();
  }

  function toggleHistory() {
    if (el.historyPanel.hidden) {
      renderHistory();
      el.historyPanel.hidden = false;
      el.historyBtn.setAttribute('aria-expanded', 'true');
    } else {
      closeHistory();
    }
  }

  function openHistoryItem(index) {
    const item = history[index];
    if (!item) return;
    currentVerse = { ...item };
    closeReading();
    cancelSpeech();
    renderCard();
    clearError();
    el.result.hidden = false;
    el.guide.hidden = true;
    el.generateBtn.textContent = ui.generate.again;
    closeHistory();
    el.result.scrollIntoView({ block: 'start' });
  }

  function loadFavorites() {
    try {
      const raw = localStorage.getItem(FAVORITES_KEY);
      favorites = raw ? JSON.parse(raw) : [];
    } catch {
      favorites = [];
    }
  }

  function saveFavorites() {
    try {
      localStorage.setItem(FAVORITES_KEY, JSON.stringify(favorites));
    } catch {
      // Storage full or unavailable — favorites just won't persist this time.
    }
  }

  function isFavorite(id) {
    return favorites.some((f) => f.id === id);
  }

  function renderFavButton() {
    if (!currentVerse) return;
    const on = isFavorite(currentVerse.id);
    el.favBtn.textContent = on ? ui.favoriteSaved : ui.favorite;
    el.favBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
  }

  function toggleFavorite() {
    if (!currentVerse) return;
    const idx = favorites.findIndex((f) => f.id === currentVerse.id);
    if (idx >= 0) {
      favorites.splice(idx, 1);
    } else {
      favorites.unshift({
        id: currentVerse.id,
        bookId: currentVerse.bookId,
        bookName: currentVerse.bookName,
        chapter: currentVerse.chapter,
        startVerse: currentVerse.startVerse,
        endVerse: currentVerse.endVerse,
        text: currentVerse.text,
        themes: currentVerse.themes,
        usedTheme: currentVerse.usedTheme || currentVerse.themes.join(' · '),
      });
    }
    saveFavorites();
    renderFavButton();
    renderFavorites();
    track(idx >= 0 ? 'remove_favorite' : 'add_favorite');
  }

  function renderFavorites() {
    el.favoritesList.replaceChildren();
    el.favoritesEmpty.hidden = favorites.length !== 0;
    favorites.forEach((item, i) => {
      const li = document.createElement('li');
      li.className = 'fav-item';
      const open = document.createElement('button');
      open.type = 'button';
      open.className = 'history-item';
      open.dataset.index = String(i);
      const ref = document.createElement('span');
      ref.className = 'history-ref';
      ref.textContent = reference(item);
      const text = document.createElement('span');
      text.className = 'history-text';
      const flat = item.text.replace(/\s+/g, ' ');
      text.textContent = flat.length > 120 ? flat.slice(0, 120) + '…' : flat;
      open.append(ref, text);
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'fav-remove';
      remove.dataset.index = String(i);
      remove.setAttribute('aria-label', ui.favoriteRemove);
      remove.textContent = '×';
      li.append(open, remove);
      el.favoritesList.appendChild(li);
    });
  }

  function closeFavorites() {
    el.favoritesPanel.hidden = true;
    el.favoritesBtn.setAttribute('aria-expanded', 'false');
  }

  function toggleFavorites() {
    if (el.favoritesPanel.hidden) {
      renderFavorites();
      el.favoritesPanel.hidden = false;
      el.favoritesBtn.setAttribute('aria-expanded', 'true');
    } else {
      closeFavorites();
    }
  }

  function openFavoriteItem(index) {
    const item = favorites[index];
    if (!item) return;
    currentVerse = { ...item };
    closeReading();
    cancelSpeech();
    renderCard();
    clearError();
    el.result.hidden = false;
    el.guide.hidden = true;
    el.generateBtn.textContent = ui.generate.again;
    closeFavorites();
    el.result.scrollIntoView({ block: 'start' });
  }

  // Wire up events
  function syncThemeButtons() {
    themeButtons.forEach((b) => {
      const id = b.dataset.theme;
      b.setAttribute('aria-pressed', id === 'All' ? String(selectedThemes.size === 0) : String(selectedThemes.has(id)));
    });
  }

  themeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.theme;
      if (id === 'All') {
        selectedThemes.clear();
      } else if (selectedThemes.has(id)) {
        selectedThemes.delete(id);
      } else {
        selectedThemes.add(id);
      }
      syncThemeButtons();
      track('select_theme');
    });
  });

  el.generateBtn.addEventListener('click', generate);
  el.historyBtn.addEventListener('click', toggleHistory);
  el.historyList.addEventListener('click', (e) => {
    const btn = e.target.closest('.history-item');
    if (btn) openHistoryItem(Number(btn.dataset.index));
  });

  el.favBtn.addEventListener('click', toggleFavorite);
  el.favoritesBtn.addEventListener('click', toggleFavorites);
  el.favoritesList.addEventListener('click', (e) => {
    const removeBtn = e.target.closest('.fav-remove');
    if (removeBtn) {
      const i = Number(removeBtn.dataset.index);
      favorites.splice(i, 1);
      saveFavorites();
      renderFavorites();
      renderFavButton();
      track('remove_favorite');
      return;
    }
    const openBtn = e.target.closest('.history-item');
    if (openBtn) openFavoriteItem(Number(openBtn.dataset.index));
  });

  el.shareBtn.addEventListener('click', shareVerse);
  el.imageBtn.addEventListener('click', saveVerseImage);

  if ('speechSynthesis' in window) {
    el.speakBtn.addEventListener('click', speakVerse);
  } else {
    el.speakBtn.hidden = true;
  }

  el.copyBtn.addEventListener('click', async () => {
    if (!currentVerse) return;
    try {
      await navigator.clipboard.writeText(currentVerse.text);
      const original = ui.result.copy;
      el.copyBtn.textContent = ui.result.copied;
      el.copyFallback.hidden = true;
      announce(ui.result.copied);
      track('copy_verse');
      setTimeout(() => {
        el.copyBtn.textContent = original;
      }, 2000);
    } catch {
      el.copyFallback.hidden = false;
    }
  });

  el.contextBtn.addEventListener('click', () => {
    if (panelState === 'context' || panelState === 'chapter') {
      closeReading();
      return;
    }
    openContext();
  });

  el.chapterBtn.addEventListener('click', openFullChapter);
  el.collapseBtn.addEventListener('click', collapseChapter);

  function loadLibrary(initial) {
    el.guide.hidden = false;
    el.result.hidden = true;
    el.generateBtn.textContent = ui.generate.first;
    fetch(dataPaths(translation).verses)
      .then((r) => r.json())
      .then((data) => {
        verses = data;
        bags.clear();
        history = [];
        renderHistory();
        if (initial) {
          applyUrlTheme();
          applyInitialTheme();
        }
        generate();
      })
      .catch(() => {
        showError(ui.errors.chapterLoad);
      });
  }

  window.addEventListener('translationchange', (e) => {
    if (!e.detail || e.detail === translation) return;
    translation = e.detail;
    loadLibrary(false);
  });

  // Load the verse library, then show a verse right away.
  loadFavorites();
  loadLibrary(true);
</script>
